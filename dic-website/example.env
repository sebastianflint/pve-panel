# Salin menjadi .env lalu sesuaikan. Jangan commit file .env.
NODE_ENV=production
PORT=3000
BASE_URL=https://dic.id
# Wajib di production: string acak minimal 32 karakter (openssl rand -hex 32)
SESSION_SECRET=
# 1 bila berjalan di belakang reverse proxy (Caddy/Nginx) dengan HTTPS
TRUST_PROXY=1
DB_PATH=./data/dic.db
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=10

# Email notifikasi form. Gunakan mailbox resmi @dic.id (lihat Assessment A#27).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=0
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Website DIC <no-reply@dic.id>"

# Akun admin pertama (dipakai oleh `npm run seed`, wajib ganti password saat login pertama)
ADMIN_EMAIL=admin@dic.id
ADMIN_PASSWORD=
