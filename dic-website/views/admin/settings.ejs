<%- include("../partials/admin-head") %>
<h1>Pengaturan situs</h1>
<% if (!smtp) { %><div class="flash warn">SMTP belum dikonfigurasi (variabel lingkungan SMTP_*). Pesan tetap tersimpan di CMS, tetapi notifikasi email tidak terkirim.</div><% } %>
<form method="post" enctype="multipart/form-data" class="card form wide"><input type="hidden" name="_csrf" value="<%= csrf %>">
<% Object.entries(groups).forEach(([g, fs]) => { %><fieldset><legend><%= g %></legend>
  <% fs.forEach(f => { %><div class="fld">
    <% if (f.type === 'bool') { %><label class="inl"><input type="checkbox" name="<%= f.name %>" value="1" <%= f.value === '1' ? 'checked' : '' %>> <%= f.label %></label>
    <% } else { %><label for="s_<%= f.name %>"><%= f.label %></label>
      <% if (f.type === 'textarea') { %><textarea id="s_<%= f.name %>" name="<%= f.name %>" rows="<%= f.rows || 3 %>"><%= f.value %></textarea>
      <% } else { %><input id="s_<%= f.name %>" name="<%= f.name %>" type="<%= f.type === 'number' ? 'number' : 'text' %>" value="<%= f.value %>"><% } %><% } %>
    <% if (f.help) { %><small class="hint"><%= f.help %></small><% } %></div><% }) %></fieldset><% }) %>
<fieldset><legend>Logo</legend><div class="fld"><img src="<%= logo %>" alt="Logo saat ini" height="60"><br><label for="s_logo">Unggah logo baru (PNG/JPG/WebP, latar transparan lebih baik)</label><input id="s_logo" type="file" name="logo" accept="image/png,image/jpeg,image/webp"><small class="hint">Logo saat ini diambil dari company profile sebagai placeholder. Ganti dengan logo vektor/resmi dari DIC (Assessment A#11).</small></div></fieldset>
<div class="actions"><button class="btn primary">Simpan pengaturan</button></div></form>
<%- include("../partials/admin-foot") %>
