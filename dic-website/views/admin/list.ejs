<%- include("../partials/admin-head") %>
<div class="head"><h1><%= r.label %></h1><a class="btn primary" href="/admin/c/<%= rkey %>/baru">+ Tambah</a></div>
<div class="tablewrap"><table class="table"><thead><tr><% r.cols.forEach(c => { %><th><%= c[1] %></th><% }) %><th>Status</th><th>Diubah</th><th></th></tr></thead><tbody>
<% rows.forEach(row => { const live = isLive(row); %>
<tr><% r.cols.forEach((c, i) => { let v = row[c[0]]; if (c[0]==='gated') v = v ? 'Ya' : 'Tidak'; %><td><% if (i === 0) { %><a href="/admin/c/<%= rkey %>/<%= row.id %>"><strong><%= v %></strong></a><% } else { %><%= v %><% } %></td><% }) %>
<td><span class="badge <%= row.status %>"><%= STATUS[row.status] %></span><% if (row.status === 'published' && !live) { %> <small>(terjadwal <%= row.publish_at %> UTC)</small><% } %></td>
<td><small><%= row.updated_at %></small></td>
<td class="act"><% if (r.publicPath && row.status === 'published' && live) { %><a href="<%= r.publicPath(row) %>" target="_blank" rel="noopener">Lihat</a><% } %>
<% if (can('reviewer')) { %><form method="post" action="/admin/c/<%= rkey %>/<%= row.id %>/status"><input type="hidden" name="_csrf" value="<%= csrf %>">
  <% if (row.status !== 'published') { %><button class="link" name="to" value="published">Tayangkan</button><% } else { %><button class="link" name="to" value="draft">Tarik</button><% } %></form><% } %></td></tr>
<% }) %>
<% if (!rows.length) { %><tr><td colspan="9" class="muted">Belum ada data.</td></tr><% } %>
</tbody></table></div>
<%- include("../partials/admin-foot") %>
