<%- include("../partials/admin-head") %>
<h1>Akun saya</h1>
<% if (forced) { %><div class="flash warn">Anda wajib mengganti password sebelum melanjutkan.</div><% } %>
<form method="post" class="card form" style="max-width:520px"><%- '<input type="hidden" name="_csrf" value="' + csrf + '">' %>
  <label>Nama<input name="name" value="<%= user.name %>" required></label>
  <p class="hint"><%= user.email %> &middot; <%= ROLES[user.role] %></p>
  <h3>Ganti password</h3>
  <label>Password saat ini<input type="password" name="current" autocomplete="current-password"></label>
  <label>Password baru (min. 12 karakter)<input type="password" name="password" minlength="12" autocomplete="new-password"></label>
  <label>Ulangi password baru<input type="password" name="password2" minlength="12" autocomplete="new-password"></label>
  <button class="btn primary">Simpan</button></form>
<%- include("../partials/admin-foot") %>
