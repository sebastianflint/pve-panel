<%- include("../partials/admin-head") %>
<div class="head"><h1>Pesan #<%= s.id %></h1><a class="btn" href="/admin/pesan">&larr; Daftar</a></div>
<div class="card wide"><dl class="dl"><dt>Waktu</dt><dd><%= s.created_at %> UTC</dd><dt>Nama</dt><dd><%= s.name %></dd><dt>Instansi</dt><dd><%= s.org %></dd>
<dt>Email</dt><dd><a href="mailto:<%= s.email %>"><%= s.email %></a></dd><dt>Telepon</dt><dd><%= s.phone || '-' %></dd><dt>Keperluan</dt><dd><%= cats[s.category] || s.category %></dd>
<dt>Pesan</dt><dd style="white-space:pre-wrap"><%= s.message %></dd><dt>Notifikasi email</dt><dd><span class="badge <%= s.email_status === 'sent' ? 'published' : 'review' %>"><%= s.email_status %></span> <%= s.email_error || '' %></dd></dl></div>
<form method="post" class="card form wide"><input type="hidden" name="_csrf" value="<%= csrf %>">
  <label class="inl"><input type="checkbox" name="handled" value="1" <%= s.handled ? 'checked' : '' %>> Sudah ditangani</label>
  <label>Catatan internal<textarea name="note" rows="3" maxlength="1000"><%= s.note || '' %></textarea></label>
  <div class="actions"><button class="btn primary" name="action" value="simpan">Simpan</button><button class="btn" name="action" value="kirim_ulang">Kirim ulang notifikasi</button><button class="btn danger" name="action" value="hapus" data-confirm="Hapus pesan ini secara permanen?">Hapus</button></div></form>
<%- include("../partials/admin-foot") %>
