<%- include('../partials/head') %>
<body>
<%- include('../partials/header') %>
<main id="konten">
<section class="page-hero"><div class="wrap"><nav class="crumb" aria-label="<%= __('Breadcrumb') %>"><a href="<%= u('/') %>"><%= __("Beranda") %></a> / <a href="<%= u('/lini-bisnis') %>"><%= __("Lini Bisnis") %></a> / <%= c(line,'title') %></nav>
  <h1><%= c(line,'title') %></h1><p class="lead"><%= c(line,'summary') %></p>
  <% if (line.realisasi !== 'aktif') { %><span class="chip rencana"><%= line.realisasi === 'rencana' ? __('Rencana ekspansi') : __('Melalui mitra') %></span><% } %></div></section>
<section class="section"><div class="wrap two top">
  <div>
    <div class="prose"><%- c(line,'body') %></div>
    <% if (items.length) { %><h2 class="h3"><%= __("Cakupan layanan") %></h2><ul class="tick big"><% items.forEach(i => { %><li><%= i %></li><% }) %></ul><% } %>
    <p><a class="btn btn-primary" href="<%= u('/kontak') %>" data-event="cta_hubungi_kami"><%= __("Tanya tentang layanan ini") %></a></p>
  </div>
  <aside>
    <% if (line.image) { %><figure class="photo"><img src="<%= line.image %>" alt="<%= c(line,'title') %>" loading="lazy"></figure><% } %>
    <div class="card pad side"><h3><%= __("Lini bisnis lainnya") %></h3><ul class="plain"><% others.forEach(o => { %><li><a href="<%= u('/lini-bisnis/' + (o.slug)) %>"><%- icon(o.icon || 'layers','sm') %> <%= c(o,'title') %></a></li><% }) %></ul></div>
  </aside>
</div></section>
</main>
<%- include('../partials/footer') %>
