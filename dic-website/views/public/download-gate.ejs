<%- include('../partials/head') %>
<body>
<%- include('../partials/header') %>
<main id="konten">
<section class="page-hero"><div class="wrap"><nav class="crumb" aria-label="Breadcrumb"><a href="/">Beranda</a> / <a href="/unduhan">Unduhan</a></nav><h1><%= doc.title %></h1><p class="lead">Isi data berikut untuk mengunduh dokumen. Data hanya dipakai sesuai <a href="/kebijakan-privasi">Kebijakan Privasi</a>.</p></div></section>
<section class="section"><div class="wrap narrow">
<form method="post" class="form card pad" novalidate>
  <%- csrfInput() %>
  <% [['name','Nama',true,'text'],['org','Instansi',false,'text'],['email','Email',true,'email']].forEach(([n,l,req,t]) => { %>
  <div class="field <%= errors[n] ? 'err' : '' %>"><label for="f-<%= n %>"><%= l %><%= req ? ' *' : '' %></label><input id="f-<%= n %>" name="<%= n %>" type="<%= t %>" value="<%= values[n] || '' %>" <%= req ? 'required' : '' %>><% if (errors[n]) { %><small><%= errors[n] %></small><% } %></div><% }) %>
  <div class="field check <%= errors.consent ? 'err' : '' %>"><label><input type="checkbox" name="consent" value="1" required> Saya menyetujui pemrosesan data sesuai Kebijakan Privasi.</label><% if (errors.consent) { %><small><%= errors.consent %></small><% } %></div>
  <button class="btn btn-primary">Unduh dokumen</button>
</form></div></section>
</main>
<%- include('../partials/footer') %>
