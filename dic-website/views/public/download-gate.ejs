<%- include('../partials/head') %>
<body>
<%- include('../partials/header') %>
<main id="konten">
<section class="page-hero"><div class="wrap"><nav class="crumb" aria-label="<%= __('Breadcrumb') %>"><a href="<%= u('/') %>"><%= __("Beranda") %></a> / <a href="<%= u('/unduhan') %>"><%= __("Unduhan") %></a></nav><h1><%= c(doc,'title') %></h1><p class="lead"><%= __("Isi data berikut untuk mengunduh dokumen. Data hanya dipakai sesuai") %> <a href="<%= u('/kebijakan-privasi') %>"><%= __("Kebijakan Privasi") %></a>.</p></div></section>
<section class="section"><div class="wrap narrow">
<form method="post" class="form card pad" novalidate>
  <%- csrfInput() %>
  <% [['name','Nama',true,'text'],['org','Instansi',false,'text'],['email','Email',true,'email']].forEach(([n,l,req,t]) => { %>
  <div class="field <%= errors[n] ? 'err' : '' %>"><label for="f-<%= n %>"><%= l %><%= req ? ' *' : '' %></label><input id="f-<%= n %>" name="<%= n %>" type="<%= t %>" value="<%= values[n] || '' %>" <%= req ? 'required' : '' %>><% if (errors[n]) { %><small><%= errors[n] %></small><% } %></div><% }) %>
  <div class="field check <%= errors.consent ? 'err' : '' %>"><label><input type="checkbox" name="consent" value="1" required> <%= __("Saya menyetujui pemrosesan data sesuai Kebijakan Privasi.") %></label><% if (errors.consent) { %><small><%= errors.consent %></small><% } %></div>
  <button class="btn btn-primary"><%= __("Unduh dokumen") %></button>
</form></div></section>
</main>
<%- include('../partials/footer') %>
