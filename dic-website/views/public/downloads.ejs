<%- include('../partials/head') %>
<body>
<%- include('../partials/header') %>
<main id="konten">
<section class="page-hero"><div class="wrap"><nav class="crumb" aria-label="<%= __('Breadcrumb') %>"><a href="<%= u('/') %>"><%= __("Beranda") %></a> / <%= __("Unduhan") %></nav><h1><%= __("Unduhan") %></h1><p class="lead"><%= __("Dokumen resmi perusahaan.") %></p></div></section>
<section class="section"><div class="wrap narrow-l">
  <% docs.forEach(d => { %><article class="card doc"><span class="ico-wrap"><%- icon('download') %></span><div><h3><%= c(d,'title') %></h3><p><%= c(d,'description') %></p>
    <p class="meta"><%= d.version ? __('Versi') + ' ' + d.version : '' %><%= d.effective_date ? ' · ' + __('berlaku') + ' ' + dateL(d.effective_date) : '' %> · <%= (d.lang || 'id').toUpperCase() %></p></div>
    <a class="btn btn-primary" href="<%= u('/unduhan/' + (d.id)) %>" data-event="download_<%= d.gated ? 'form' : 'direct' %>"><%= __("Unduh") %></a></article><% }) %>
  <% if (!docs.length) { %><p class="muted"><%= __("Belum ada dokumen yang tersedia.") %></p><% } %>
</div></section>
</main>
<%- include('../partials/footer') %>
