<article class="card post">
  <a href="/berita/<%= p.slug %>" class="thumb"><% if (p.image) { %><img src="<%= p.image %>" alt="" loading="lazy"><% } else { %><span class="ph"><%- icon('layers') %></span><% } %></a>
  <div class="pad"><span class="chip"><%= CAT_NEWS[p.category] || p.category %></span> <time datetime="<%= p.published_at %>"><%= U.dateId(p.published_at) %></time>
  <h3><a href="/berita/<%= p.slug %>"><%= p.title %></a></h3>
  <p><%= p.excerpt || U.excerpt(p.body, 120) %></p></div>
</article>
