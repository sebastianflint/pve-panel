<a class="skip" href="#konten"><%= __("Lewati ke konten") %></a>
<% if (preview) { %><div class="preview-bar"><%= __("Mode pratinjau: konten yang belum tayang ikut ditampilkan.") %> <a href="/admin"><%= __("Kembali ke CMS") %></a></div><% } %>
<header class="site-header" id="top">
  <div class="topbar"><div class="wrap">
    <span class="topbar-note"><%- icon('clock') %> <%= st.service_hours %></span>
    <span class="topbar-links">
      <a href="mailto:<%= st.public_email %>" data-event="click_email"><%- icon('mail') %> <%= st.public_email %></a>
      <a href="<%= u('/unduhan') %>"><%= __("Unduhan") %></a>
      <span class="lang" role="group" aria-label="<%= __('Bahasa') %>"><a href="<%= meta.path || '/' %>" hreflang="id" lang="id" class="<%= lang === 'id' ? 'cur' : '' %>" <%- lang === 'id' ? 'aria-current="true"' : '' %>>ID</a><a href="<%= toEn(meta.path || '/') %>" hreflang="en" lang="en" class="<%= lang === 'en' ? 'cur' : '' %>" <%- lang === 'en' ? 'aria-current="true"' : '' %>>EN</a></span>
    </span>
  </div></div>
  <div class="wrap navbar">
    <a class="brand" href="<%= u('/') %>" aria-label="<%= st.site_name %> - <%= __('Beranda') %>"><img src="<%= st.logo || '/img/logo.png' %>" alt="<%= st.site_short || 'DIC' %>" height="44"><span class="brand-text"><strong><%= st.site_name %></strong><small><%= __("Pengadaan Barang dan Jasa") %></small></span></a>
    <button class="nav-toggle" aria-expanded="false" aria-controls="menu" aria-label="<%= __('Buka menu') %>" data-label-open="<%= __('Buka menu') %>" data-label-close="<%= __('Tutup menu') %>"><%- icon('menu') %></button>
    <nav id="menu" class="menu" aria-label="<%= __('Navigasi utama') %>">
      <ul>
        <li><a href="<%= u('/') %>" class="<%= meta.path === '/' ? 'on' : '' %>"><%= __("Beranda") %></a></li>
        <li><a href="<%= u('/tentang') %>" class="<%= meta.path === '/tentang' ? 'on' : '' %>"><%= __("Tentang Kami") %></a></li>
        <li class="has-sub">
          <a href="<%= u('/lini-bisnis') %>" class="<%= (meta.path || '').startsWith('/lini-bisnis') ? 'on' : '' %>"><%= __("Lini Bisnis") %> <%- icon('chevron','sm') %></a>
          <% if (navLines.length) { %><ul class="sub">
            <% navLines.forEach(l => { %><li><a href="<%= u('/lini-bisnis/' + (l.slug)) %>"><%= c(l,'title') %></a></li><% }) %>
          </ul><% } %>
        </li>
        <li><a href="<%= u('/berita') %>" class="<%= (meta.path || '').startsWith('/berita') ? 'on' : '' %>"><%= __("Berita") %></a></li>
        <li><a href="<%= u('/kontak') %>" class="<%= meta.path === '/kontak' ? 'on' : '' %>"><%= __("Kontak") %></a></li>
      </ul>
      <form class="search" action="<%= u('/cari') %>" role="search"><label class="sr" for="q"><%= __("Cari") %></label><input id="q" name="q" type="search" placeholder="<%= __('Cari di website') %>" maxlength="80"><button aria-label="<%= __('Cari') %>"><%- icon('search') %></button></form>
      <a class="btn btn-primary nav-cta" href="<%= u('/kontak') %>" data-event="cta_hubungi_kami"><%= __("Hubungi Kami") %></a>
    </nav>
  </div>
</header>
