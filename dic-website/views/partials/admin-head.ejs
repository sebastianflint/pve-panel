<!doctype html><html lang="id"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<meta name="robots" content="noindex,nofollow"><title><%= title %> | CMS DIC</title>
<link rel="icon" href="/img/favicon.png"><link rel="stylesheet" href="/vendor/inter/index.css"><link rel="stylesheet" href="/css/admin.css?v=1">
<% if (typeof withEditor !== 'undefined' && withEditor) { %><link rel="stylesheet" href="/vendor/quill/quill.snow.css"><% } %>
</head><body>
<% if (user) { %>
<div class="shell">
<aside class="side">
  <a class="logo" href="/admin"><img src="/img/logo.png" alt="DIC" height="34"><span>CMS</span></a>
  <nav>
    <a href="/admin" class="<%= nav === '/' ? 'on' : '' %>">Dashboard</a>
    <p>Konten</p>
    <% ['slides','highlights','lini-bisnis','roadmap','proyek','kantor','berita','dokumen','halaman'].forEach(k => { %><a href="/admin/c/<%= k %>" class="<%= nav.startsWith('/c/' + k) ? 'on' : '' %>"><%= resources[k].label %></a><% }) %>
    <a href="/admin/media" class="<%= nav.startsWith('/media') ? 'on' : '' %>">Pustaka media</a>
    <p>Operasional</p>
    <% if (canSubs) { %><a href="/admin/pesan" class="<%= nav.startsWith('/pesan') ? 'on' : '' %>">Pesan masuk</a><% } %>
    <% if (can('admin')) { %><a href="/admin/pengaturan" class="<%= nav.startsWith('/pengaturan') ? 'on' : '' %>">Pengaturan situs</a><a href="/admin/pengguna" class="<%= nav.startsWith('/pengguna') ? 'on' : '' %>">Pengguna</a><% if (typeof sandbox !== 'undefined' && sandbox) { %><a href="/admin/outbox" class="<%= nav.startsWith('/outbox') ? 'on' : '' %>">Outbox sandbox</a><% } %><a href="/admin/audit" class="<%= nav.startsWith('/audit') ? 'on' : '' %>">Log aktivitas</a><% } %>
  </nav>
  <div class="me"><a href="/admin/akun"><strong><%= user.name %></strong><br><small><%= ROLES[user.role] %></small></a>
    <form method="post" action="/admin/logout"><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="btn sm">Keluar</button></form>
    <a class="vsite" href="/" target="_blank" rel="noopener">Lihat situs &nearr;</a></div>
</aside>
<main class="main">
<% if (flash) { %><div class="flash <%= flash.type %>" role="status"><%= flash.msg %></div><% } %>
<% } else { %><main class="main solo"><% } %>
