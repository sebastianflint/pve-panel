# Instalasi native: salin ke /etc/systemd/system/dic-web.service
[Unit]
Description=DIC Website and CMS (dic.id)
After=network.target

[Service]
Type=simple
User=dic
Group=dic
WorkingDirectory=/opt/dic.id
EnvironmentFile=/opt/dic.id/.env
ExecStartPre=/usr/bin/node src/seed.js
ExecStart=/usr/bin/node src/server.js
Restart=on-failure
RestartSec=5
# Hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/dic.id/data /opt/dic.id/uploads

[Install]
WantedBy=multi-user.target
