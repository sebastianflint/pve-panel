{
  "name": "pve-panel",
  "version": "1.11.0",
  "description": "Customer self-service control panel for Proxmox VE",
  "private": true,
  "type": "module",
  "main": "src/server.js",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sebastianflint/pve-panel.git"
  },
  "homepage": "https://github.com/sebastianflint/pve-panel#readme",
  "bugs": {
    "url": "https://github.com/sebastianflint/pve-panel/issues"
  },
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning src/server.js",
    "dev": "node --disable-warning=ExperimentalWarning --watch src/server.js",
    "user:create": "node --disable-warning=ExperimentalWarning scripts/create-user.js",
    "vm:assign": "node --disable-warning=ExperimentalWarning scripts/assign-vm.js",
    "user:reset-2fa": "node --disable-warning=ExperimentalWarning scripts/reset-2fa.js",
    "db:backup": "node --disable-warning=ExperimentalWarning scripts/backup-db.js",
    "test": "node --disable-warning=ExperimentalWarning --test --test-reporter=spec \"test/unit/**/*.test.mjs\" \"test/api/**/*.test.mjs\"",
    "test:unit": "node --disable-warning=ExperimentalWarning --test --test-reporter=spec \"test/unit/**/*.test.mjs\"",
    "test:api": "node --disable-warning=ExperimentalWarning --test --test-reporter=spec \"test/api/**/*.test.mjs\"",
    "test:coverage": "node --disable-warning=ExperimentalWarning --test --experimental-test-coverage --test-coverage-include=\"src/**\" --test-reporter=spec --test-reporter-destination=stdout \"test/unit/**/*.test.mjs\" \"test/api/**/*.test.mjs\"",
    "test:e2e": "playwright test"
  },
  "engines": {
    "node": ">=22.13"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.0",
    "@fastify/jwt": "^10.2.2",
    "@fastify/rate-limit": "^11.2.0",
    "@fastify/static": "^10.1.5",
    "@fastify/websocket": "^11.3.3",
    "@novnc/novnc": "^1.5.0",
    "@simplewebauthn/browser": "^14.0.0",
    "@simplewebauthn/server": "^14.0.3",
    "bcryptjs": "^3.0.3",
    "dotenv": "^18.0.5",
    "fastify": "^5.0.0",
    "fastify-plugin": "^6.0.0",
    "nodemailer": "^10.0.14",
    "openid-client": "^6.8.8",
    "qrcode": "^1.5.4",
    "undici": "^8.11.2",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "mailparser": "^3.9.35",
    "smtp-server": "^3.19.17"
  }
}
